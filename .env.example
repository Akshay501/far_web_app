# FAR web app secrets - copy to .env and fill in. NEVER commit .env.
# Settings that are not secret stay in config.yml.

# Database password (user/host/db name stay in config.yml)
FAR_DB_PASSWORD=

# Flask session-signing key: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Scopus API key (for the publication sync's second source)
FAR_SCOPUS_API_KEY=

# Clarkson single sign-on. Leave empty to use password login (local
# development). Set to the CAS server address once IT has registered
# the app, e.g. https://cas.clarkson.edu/cas
CAS_SERVER_URL=
# The CAS attribute that carries the Clarkson employee ID. Clarkson
# re-uses carLicense for it; leave unset unless IT moves it.
# CAS_EMPLOYEE_ID_ATTRIBUTE=carLicense
# What a valid employee ID looks like (a regular expression). Default:
# Clarkson's EMPLID, exactly 7 digits. Set both lines only for another
# institution, e.g. EMPLOYEE_ID_PATTERN=^E-[0-9]{5}$
# EMPLOYEE_ID_PATTERN=
# EMPLOYEE_ID_HINT=
